# Supabase (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, NEVER prefixed with NEXT_PUBLIC_ — full read/write access,
# bypasses every RLS policy. Used only in src/app/api/admin/* route handlers,
# which run on the server and are never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only: signs every quote; payment capture verifies the signature.
QUOTE_SIGNING_SECRET=change-me-in-vercel

# Server-only: the password for /admin. Pick a long random string — this is
# the only thing standing between the internet and your bookings once
# Supabase is connected. Also signs the admin session cookie.
ADMIN_SECRET_KEY=change-me-in-vercel

# Optional: mirrors every new Y2K wedding-desk booking (/e/Y2K) into a Google
# Sheet, on top of the Admin OS — see src/app/api/wedding/booking/route.ts.
# Unset by default; the booking still saves normally either way. Set both to
# turn it on: Y2K_SHEET_WEBHOOK_URL is the Apps Script Web App's /exec URL,
# Y2K_SHEET_SECRET is a string you invent that must match the one pasted
# into the Apps Script (so random POSTs to the URL can't write into the sheet).
Y2K_SHEET_WEBHOOK_URL=
Y2K_SHEET_SECRET=
